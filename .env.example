# Google Apps Script Web App URL ending in /exec
GOOGLE_APPS_SCRIPT_URL=

# Use the same long random value in Netlify and Apps Script Script Properties
LEADS_SHARED_SECRET=

# LINE Messaging API channel access token (keep server-side only)
LINE_CHANNEL_ACCESS_TOKEN=

# LINE userId, groupId, or roomId that should receive lead notifications
LINE_TARGET_ID=
