# Google Apps Script Web App URL ending in /exec
GOOGLE_APPS_SCRIPT_URL=

# Use the same long random value in Netlify and Apps Script Script Properties
LEADS_SHARED_SECRET=

# LINE Messaging API channel access token (keep server-side only)
LINE_CHANNEL_ACCESS_TOKEN=

# LINE userId, groupId, or roomId that should receive lead notifications
LINE_TARGET_ID=

# Admin login. Use a unique username, a strong password, and a random secret of at least 32 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional separate secret for admin data. Falls back to LEADS_SHARED_SECRET when omitted.
ADMIN_DATA_SHARED_SECRET=
